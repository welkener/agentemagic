# Variáveis do docker-compose.deploy.yml — preencher e salvar como `.env`
# só no servidor (nunca commitar valores reais; ver backend/.gitignore).
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
POSTGRES_PASSWORD=
GROQ_API_KEY=
FIELD_ENCRYPTION_KEY=
MAGICLINK_SIGNING_KEY=
PAINEL_BASE_URL=
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
DEFAULT_FROM_EMAIL=no-reply@magicbi.local

# SMTP — SEM ISTO o Magic Link do contador não chega no e-mail dele (fica só no
# log do container) e os alertas de rejeição fiscal também não saem.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
